{
  "manifest_version": 3,
  "name": "Copy Table",
  "version": "1.0.0",
  "icons": {
    "16": "icons/table-16.svg",
    "32": "icons/table.svg",
    "48": "icons/table.svg",
    "96": "icons/table.svg",
    "128": "icons/table.svg"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/table-16.svg",
      "32": "icons/table.svg"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "commands": {
    "copy-table-csv": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "MacCtrl+Shift+C"
      },
      "description": "Copy the table at the selection or focus as CSV"
    }
  },
  "permissions": ["activeTab", "clipboardWrite", "menus", "notifications", "scripting"],
  "browser_specific_settings": {
    "gecko": {
      "id": "copy-table@peterelmwood.com",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
