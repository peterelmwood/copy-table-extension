{
  "manifest_version": 3,
  "name": "Copy Table",
  "version": "1.0.0",
  "action": {
    "default_popup": "popup/index.html"
  },
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "copy-table@copytable.invalid",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
