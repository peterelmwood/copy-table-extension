{
  "name": "copy-table-extension",
  "version": "1.0.0",
  "description": "Firefox-first Copy Structured Data extension scaffold",
  "scripts": {
    "clean": "node scripts/build.mjs clean",
    "build": "node scripts/build.mjs build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "lint:extension": "web-ext lint --source-dir dist",
    "start:firefox": "web-ext run --source-dir dist",
    "package": "web-ext build --source-dir dist --artifacts-dir web-ext-artifacts --overwrite-dest",
    "verify": "npm run clean && npm run typecheck && npm run lint && npm test && npm run build && npm run lint:extension"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@bradygaster/squad-cli": "^0.12.0",
    "@bradygaster/squad-sdk": "^0.12.0",
    "@eslint/js": "^9.0.0",
    "@types/firefox-webext-browser": "^120.0.4",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "0.28.2",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.0.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "web-ext": "^9.0.0"
  }
}
