{
  "name": "copy-table-extension",
  "version": "1.0.0",
  "description": "Firefox-first Copy Table extension scaffold",
  "scripts": {
    "clean": "node scripts/build.mjs clean",
    "build": "node scripts/build.mjs build",
    "typecheck": "node node_modules/typescript/lib/tsc.js --noEmit",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "format:check": "prettier --check package.json package-lock.json tsconfig.json vitest.config.ts eslint.config.js prettier.config.js scripts src tests",
    "test": "node node_modules/vitest/vitest.mjs run",
    "lint:extension": "node scripts/build.mjs lint",
    "start:firefox": "node scripts/build.mjs start:firefox",
    "package": "node scripts/build.mjs package",
    "verify": "node scripts/build.mjs verify"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/eslint-parser": "^7.28.6",
    "@babel/plugin-syntax-typescript": "^7.27.1",
    "@bradygaster/squad-cli": "^0.12.0",
    "@bradygaster/squad-sdk": "^0.12.0",
    "@eslint/js": "^9.0.0",
    "@types/firefox-webext-browser": "^120.0.4",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "0.28.2",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "jszip": "3.10.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.0.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "web-ext": "^9.0.0"
  }
}
